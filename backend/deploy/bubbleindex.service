[Unit]
Description=BubbleIndex Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BubbleIndex/backend
EnvironmentFile=/home/ubuntu/BubbleIndex/backend/.env
ExecStart=/home/ubuntu/BubbleIndex/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
