# === Required API Keys ===
FRED_API_KEY=your_fred_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# === Database & Cache ===
# Use absolute paths on the server to avoid working-directory issues
DATABASE_URL=sqlite:////home/ubuntu/BubbleIndex/backend/data/bubble_index.db
CACHE_DIR=/home/ubuntu/BubbleIndex/backend/data/cache

# === App Settings ===
DEBUG=false
DAILY_SYNC_HOUR_UTC=18

# === CORS — set to your frontend domain ===
CORS_ORIGINS=["https://yourdomain.com"]
